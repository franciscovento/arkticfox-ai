---
import type { Locale, PageKey } from '@/i18n/routes';
import { getPath, t } from '@/i18n/utils';

interface Props {
  locale: Locale;
  /** Page the language switch stays on. */
  pageKey: PageKey;
  /** The header stays fixed over the film. */
  fixed?: boolean;
}

const { locale, pageKey, fixed = false } = Astro.props;
---

<header
  class:list={[
    'flex items-center justify-between px-5 py-5 md:px-10 lg:justify-end',
    fixed ? 'fixed inset-x-0 top-0 z-30' : 'relative z-20',
  ]}
  data-site-header
>
  <a
    class="label shrink-0 whitespace-nowrap text-white lg:absolute lg:left-1/2 lg:-translate-x-1/2"
    href={getPath(locale, pageKey)}
  >
    {t(locale, 'meta.siteName')}
  </a>
  <nav class="flex items-center gap-5" aria-label={t(locale, 'nav.languageLabel')}>
    <a
      class:list={['label hover-fox', locale === 'en' ? 'text-white' : 'text-white/70']}
      href={getPath('en', pageKey)}
      hreflang="en"
      aria-current={locale === 'en' ? 'page' : undefined}
    >
      {t(locale, 'nav.languageEn')}
    </a>
    <a
      class:list={['label hover-fox', locale === 'es' ? 'text-white' : 'text-white/70']}
      href={getPath('es', pageKey)}
      hreflang="es"
      aria-current={locale === 'es' ? 'page' : undefined}
    >
      {t(locale, 'nav.languageEs')}
    </a>
  </nav>
</header>

<script>
  import { onPageReady } from '../motion/ready';

  let onScroll: (() => void) | undefined;

  /** Clear over the film. Once the hero has gone, the bar gets a glass backing so it never fights the type below. */
  function bootHeader() {
    if (onScroll) window.removeEventListener('scroll', onScroll);
    const header = document.querySelector<HTMLElement>('[data-site-header]');
    const hero = document.querySelector<HTMLElement>('[data-snow-dive]');
    if (!header || !hero) return;

    let frame = 0;
    const update = () => {
      frame = 0;
      const past = hero.getBoundingClientRect().bottom <= header.offsetHeight;
      header.dataset.scrolled = past ? 'true' : 'false';
    };
    onScroll = () => {
      if (!frame) frame = window.requestAnimationFrame(update);
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    update();
  }

  onPageReady(bootHeader);
</script>
