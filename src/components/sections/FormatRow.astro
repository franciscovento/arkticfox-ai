---
import type { Locale } from '@/i18n/routes';
import { t } from '@/i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ratios = [
  { ratio: '9:16', label: 'shared.formats.r916', box: 'aspect-[9/16] w-16' },
  { ratio: '4:5', label: 'shared.formats.r45', box: 'aspect-[4/5] w-20' },
  { ratio: '1:1', label: 'shared.formats.r11', box: 'aspect-square w-20' },
  { ratio: '16:9', label: 'shared.formats.r169', box: 'aspect-video w-28' },
] as const;
---

<section class="bg-polar-night px-5 py-20 text-white md:px-10 md:py-28">
  <div class="mx-auto max-w-6xl">
    <h2 class="max-w-xl font-serif text-4xl md:text-6xl">
      {t(locale, 'shared.formats.headline')}
    </h2>
    <p class="mt-4 max-w-xl font-sans text-sm leading-relaxed text-white/80">
      {t(locale, 'shared.formats.body')}
    </p>
    <ul class="mt-10 flex flex-wrap items-end gap-8">
      {ratios.map((item) => (
        <li class="flex flex-col gap-3">
          <div
            class:list={['rounded-card-sm border border-white/40', item.box]}
          ></div>
          <p class="font-serif text-2xl">{item.ratio}</p>
          <p class="font-sans text-sm text-white/80">{t(locale, item.label)}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
