<script>
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { runScrollScene } from '../../motion/gsap';
  import { startSmoothScroll, stopSmoothScroll } from '../../motion/lenis';
  import { onPageReady } from '../../motion/ready';
  import { pointer } from '../../motion/pointer';
  import { prefersReducedMotion } from '../../motion/reduced';

  let diveTrigger: ScrollTrigger | undefined;
  let diveFrame = 0;
  let stopSnow: (() => void) | undefined;
  let stopVideo: (() => void) | undefined;
  let stopFrames: (() => void) | undefined;

  function teardownDive() {
    diveTrigger?.kill();
    diveTrigger = undefined;
    if (diveFrame) window.cancelAnimationFrame(diveFrame);
    diveFrame = 0;
    stopSnow?.();
    stopSnow = undefined;
    stopVideo?.();
    stopVideo = undefined;
    stopFrames?.();
    stopFrames = undefined;
    stopSmoothScroll();
  }

  function bootDive() {
    teardownDive();
    const root = document.querySelector<HTMLElement>('[data-snow-dive]');
    if (!root) return;
    root.dataset.diveBound = 'true';
    startSmoothScroll();

    const canvas = root.querySelector<HTMLCanvasElement>('[data-dive-snow]');
    const layers = [...root.querySelectorAll<HTMLElement>('[data-drift-layer]')];
    const veil = root.querySelector<HTMLElement>('[data-dive-veil]');
    const video = root.querySelector<HTMLVideoElement>('[data-dive-video]');
    stopVideo = bindDiveVideo(video);
    const beats = [...root.querySelectorAll<HTMLElement>('[data-journey-beat]')];
    const pieces = [...root.querySelectorAll<HTMLElement>('[data-journey-piece]')];
    const mouse = pointer();
    let progress = 0;
    const scrubCanvas = root.querySelector<HTMLCanvasElement>('[data-scrub-frames]');
    const frameScrub = bindScrubFrames(scrubCanvas, () => progress);
    stopFrames = frameScrub.stop;
    // `dive` tracks scroll *speed*, not position: moving makes the snow come at the camera,
    // stopping lets it settle back into a calm fall. It decays on its own in the frame loop.
    let dive = 0;
    let diveTarget = 0;

    const place = () => {
      for (const layer of layers) {
        const depth = Number(layer.dataset.depth) || 0;
        const rise = progress * depth * 46;
        const scale = 1 + progress * depth * 1.15;
        const turnX = (mouse.ex - 0.5) * depth * -38;
        const turnY = (mouse.ey - 0.5) * depth * -9;
        layer.style.transform = `translate3d(${turnX.toFixed(2)}px, ${rise.toFixed(2)}vh, 0) translateY(${turnY.toFixed(2)}px) scale(${scale.toFixed(4)})`;
      }
      if (veil) veil.style.opacity = String(Math.min(1, progress * 1.25));
    };

    runScrollScene(() => {
      const apply = (self: ScrollTrigger) => {
        progress = self.progress;
        diveTarget = Math.min(1, Math.abs(self.getVelocity()) / 2400);
        place();
        frameScrub.scrub();
        for (const beat of beats) {
          const from = Number(beat.dataset.from);
          const to = Number(beat.dataset.to);
          const opacity = beatOpacity(progress, from, to);
          const shown = opacity > 0.04;
          const leaving = progress > from + (to - from) * 0.55;
          beat.style.opacity = String(opacity);
          beat.style.visibility = shown ? 'visible' : 'hidden';
          beat.style.pointerEvents = shown ? 'auto' : 'none';
          beat.style.transform = `translateY(${(1 - opacity) * (leaving ? -64 : 20)}px)`;
        }
        for (const piece of pieces) {
          const opacity = pieceOpacity(
            progress,
            Number(piece.dataset.from),
            Number(piece.dataset.to),
            Number(piece.dataset.fade),
          );
          const shown = opacity > 0.04;
          const rise = piece.dataset.enter === 'up';
          piece.style.opacity = String(opacity);
          piece.style.visibility = shown ? 'visible' : 'hidden';
          piece.style.pointerEvents = shown ? 'auto' : 'none';
          piece.style.transform = rise
            ? `translateY(${(1 - opacity) * 28}px)`
            : `translateX(${(1 - opacity) * 96}px)`;
        }
      };

      diveTrigger = ScrollTrigger.create({
        trigger: root,
        start: 'top top',
        end: 'bottom bottom',
        onUpdate: apply,
        onRefresh: apply,
      });

      // Keeps running when the scroll is idle: the pointer still moves the scene, and `dive`
      // needs to ease back to zero once the wheel stops, which no scroll event will tell us.
      const frameLoop = () => {
        diveTarget *= 0.92;
        dive += (diveTarget - dive) * 0.09;
        place();
        diveFrame = window.requestAnimationFrame(frameLoop);
      };
      diveFrame = window.requestAnimationFrame(frameLoop);
    });

    if (!prefersReducedMotion() && canvas) {
      // `data-snow-direction="dive"` on the canvas is the previous head-on field.
      const direction = canvas.dataset.snowDirection === 'dive' ? 'dive' : 'fall';
      stopSnow =
        direction === 'dive' ? mountSnow(canvas, () => dive, mouse) : mountFallingSnow(canvas, mouse);
    }

    window.requestAnimationFrame(() => {
      ScrollTrigger.refresh();
    });
  }

  document.addEventListener('astro:before-swap', teardownDive);
  onPageReady(bootDive);

  function pieceOpacity(progress: number, from: number, to: number, fade = 0.1): number {
    if (progress < from) return 0;
    const fadeIn = Math.min(1, (progress - from) / (Number.isFinite(fade) && fade > 0 ? fade : 0.1));
    if (Number.isNaN(to)) return fadeIn;
    if (progress > to) return 0;
    return Math.min(fadeIn, Math.min(1, (to - progress) / 0.08));
  }

  function beatOpacity(progress: number, from: number, to: number, edge = 0.05): number {
    const fade = Number.isFinite(edge) && edge > 0 ? edge : 0.05;
    if (progress < from || progress > to) return 0;
    const fadeIn = from === 0 ? 1 : Math.min(1, (progress - from) / fade);
    const fadeOut = to >= 1 ? 1 : Math.min(1, (to - progress) / fade);
    return Math.min(fadeIn, fadeOut);
  }

  /** Background loop. Scroll does not seek it. Reduced motion and a hidden tab leave it paused. */
  function bindDiveVideo(video: HTMLVideoElement | null) {
    if (!video) return () => {};

    video.muted = true;
    video.loop = true;
    if (prefersReducedMotion()) {
      video.pause();
      return () => video.pause();
    }

    const onVisibility = () => {
      if (document.hidden) video.pause();
      else void video.play();
    };

    document.addEventListener('visibilitychange', onVisibility);
    void video.play();

    return () => {
      document.removeEventListener('visibilitychange', onVisibility);
      video.pause();
    };
  }

  /**
   * Scroll-scrubbed stills for the /v2 cut. Each frame is a full 1080p image, so the film
   * advances with scroll position instead of playing on its own.
   */
  function bindScrubFrames(canvas: HTMLCanvasElement | null, readProgress: () => number) {
    if (!canvas) return { scrub: () => {}, stop: () => {} };
    const context = canvas.getContext('2d');
    if (!context) return { scrub: () => {}, stop: () => {} };
    const ctx = context;

    const listed = Number(canvas.dataset.frameCount);
    const count = Number.isFinite(listed) && listed > 0 ? Math.floor(listed) : 0;
    if (!count) return { scrub: () => {}, stop: () => {} };
    const total = prefersReducedMotion() ? 1 : count;
    const base = canvas.dataset.frameBase || '/media/scrub/frame-';
    const images: HTMLImageElement[] = [];
    let drawn = -1;
    let target = 0;
    let ready = 0;
    let disposed = false;

    const loader = document.querySelector<HTMLElement>('[data-loader]');
    const bar = document.querySelector<HTMLElement>('[data-loader-bar]');

    const finishLoader = () => {
      loader?.classList.add('is-done');
      loader?.setAttribute('aria-hidden', 'true');
    };

    const paint = (index: number) => {
      target = index;
      const img = images[index];
      if (!img || !img.complete || img.naturalWidth === 0) return;
      const { width, height } = canvas.getBoundingClientRect();
      const imageRatio = img.naturalWidth / img.naturalHeight;
      const viewRatio = width / height;
      let dw = width;
      let dh = height;
      let dx = 0;
      let dy = 0;
      if (imageRatio > viewRatio) {
        dw = height * imageRatio;
        dx = (width - dw) / 2;
      } else {
        dh = width / imageRatio;
        dy = (height - dh) / 2;
      }
      ctx.clearRect(0, 0, width, height);
      ctx.drawImage(img, dx, dy, dw, dh);
      drawn = index;
      canvas.dataset.frame = String(index);
    };

    const resize = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      const { width, height } = canvas.getBoundingClientRect();
      canvas.width = Math.max(1, Math.floor(width * dpr));
      canvas.height = Math.max(1, Math.floor(height * dpr));
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      const show = drawn >= 0 ? drawn : target;
      drawn = -1;
      paint(show);
    };

    const noteReady = () => {
      ready += 1;
      if (bar) bar.style.transform = `scaleX(${Math.min(1, ready / total)})`;
      paint(target);
      if (ready >= total) finishLoader();
    };

    for (let index = 0; index < total; index += 1) {
      const img = new Image();
      img.decoding = 'async';
      img.src = `${base}${String(index + 1).padStart(3, '0')}.webp`;
      img.onload = () => {
        if (!disposed) noteReady();
      };
      img.onerror = () => {
        if (!disposed) noteReady();
      };
      images[index] = img;
    }

    resize();
    window.addEventListener('resize', resize, { passive: true });

    return {
      scrub: () => {
        const index = Math.min(total - 1, Math.max(0, Math.round(readProgress() * (total - 1))));
        if (index !== drawn) paint(index);
      },
      stop: () => {
        disposed = true;
        window.removeEventListener('resize', resize);
      },
    };
  }

  /**
   * Top-down snow for `data-snow-direction="fall"`. Flakes enter above the frame and leave
   * through the bottom. Scroll speed does not pull them toward the camera.
   */
  function mountFallingSnow(canvas: HTMLCanvasElement, mouse: { ex: number; ey: number }) {
    const context = canvas.getContext('2d');
    if (!context) return undefined;
    const ctx = context;
    const color = getComputedStyle(document.documentElement).getPropertyValue('--color-white').trim();
    if (!color) return undefined;

    type Flake = {
      x: number;
      y: number;
      r: number;
      speed: number;
      sway: number;
      phase: number;
      alpha: number;
    };
    let flakes: Flake[] = [];
    let frame = 0;
    let active = false;
    let time = 0;

    const spawn = (anywhere: boolean, width: number, height: number): Flake => ({
      x: Math.random() * width,
      y: anywhere ? Math.random() * height : -Math.random() * 28 - 4,
      r: Math.random() * 1.5 + 0.45,
      speed: Math.random() * 0.9 + 0.45,
      sway: Math.random() * 0.4 + 0.15,
      phase: Math.random() * Math.PI * 2,
      alpha: Math.random() * 0.4 + 0.25,
    });

    const resize = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      const { width, height } = canvas.getBoundingClientRect();
      canvas.width = Math.max(1, Math.floor(width * dpr));
      canvas.height = Math.max(1, Math.floor(height * dpr));
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      const count = Math.round(Math.min(220, Math.max(70, (width * height) / 9000)));
      flakes = Array.from({ length: count }, () => spawn(true, width, height));
    };

    const draw = () => {
      if (!active) return;
      const { width, height } = canvas.getBoundingClientRect();
      ctx.clearRect(0, 0, width, height);
      ctx.fillStyle = color;
      time += 0.016;
      const wind = (mouse.ex - 0.5) * 0.4;

      for (const flake of flakes) {
        flake.y += flake.speed;
        flake.x += Math.sin(time * flake.sway + flake.phase) * 0.35 + wind;
        if (flake.y > height + 8) Object.assign(flake, spawn(false, width, height));
        if (flake.x < -12) flake.x = width + 8;
        if (flake.x > width + 12) flake.x = -8;
        ctx.globalAlpha = flake.alpha;
        ctx.beginPath();
        ctx.arc(flake.x, flake.y, flake.r, 0, Math.PI * 2);
        ctx.fill();
      }

      ctx.globalAlpha = 1;
      frame = window.requestAnimationFrame(draw);
    };

    const start = () => {
      if (active) return;
      active = true;
      frame = window.requestAnimationFrame(draw);
    };

    const stop = () => {
      active = false;
      window.cancelAnimationFrame(frame);
    };

    const onVisibility = () => {
      if (document.hidden) stop();
      else start();
    };

    resize();
    window.addEventListener('resize', resize, { passive: true });
    document.addEventListener('visibilitychange', onVisibility);
    start();

    return () => {
      stop();
      window.removeEventListener('resize', resize);
      document.removeEventListener('visibilitychange', onVisibility);
    };
  }

  /**
   * Snow in perspective, used when `data-snow-direction="dive"`. Flakes travel toward the camera.
   * At rest they drift down; as `dive` rises with scroll speed, gravity gives way to a head-on rush.
   * The pointer shifts the vanishing point, so looking around feels like turning your head.
   */
  function mountSnow(
    canvas: HTMLCanvasElement,
    readDive: () => number,
    mouse: { ex: number; ey: number },
  ) {
    const context = canvas.getContext('2d');
    if (!context) return undefined;
    const ctx = context;
    const color = getComputedStyle(document.documentElement).getPropertyValue('--color-white').trim();
    if (!color) return undefined;

    // x/y are offsets from the axis of travel, not screen coordinates. z is distance.
    type Flake = { x: number; y: number; z: number; s: number; phase: number; drift: number };
    let flakes: Flake[] = [];
    let frame = 0;
    let active = false;
    let time = 0;

    const spawn = (far: boolean): Flake => ({
      x: (Math.random() - 0.5) * 2.4,
      y: (Math.random() - 0.5) * 2.4,
      z: far ? 1 : Math.random() * 0.9 + 0.1,
      s: Math.random() * 0.55 + 0.45,
      phase: Math.random() * Math.PI * 2,
      drift: Math.random() * 0.5 + 0.7,
    });

    const resize = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      const { width, height } = canvas.getBoundingClientRect();
      canvas.width = Math.max(1, Math.floor(width * dpr));
      canvas.height = Math.max(1, Math.floor(height * dpr));
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      const count = Math.round(Math.min(260, Math.max(90, (width * height) / 7600)));
      flakes = Array.from({ length: count }, () => spawn(false));
    };

    const draw = () => {
      if (!active) return;
      const dive = readDive();
      const { width, height } = canvas.getBoundingClientRect();
      ctx.clearRect(0, 0, width, height);
      ctx.fillStyle = color;
      time += 0.006;

      // Head turn: the vanishing point leads the pointer, so the field swings around it.
      const vanishX = 0.5 + (mouse.ex - 0.5) * 0.3;
      const vanishY = 0.52 + (mouse.ey - 0.5) * 0.18;
      // Diving spreads the field wider, so flakes sweep past the edges instead of straight down.
      const spread = 0.2 + dive * 0.14;

      for (const flake of flakes) {
        // A slow base approach keeps the hero alive. Scroll speed turns it into a rush.
        flake.z -= (0.0016 + dive * 0.03) * flake.s;
        // Gravity rules at rest and fades out as the dive takes over.
        flake.y += 0.0017 * (1 - dive * 0.82) * flake.s;
        flake.x += Math.sin(time * flake.drift + flake.phase) * 0.0009;

        if (flake.z <= 0.06) Object.assign(flake, spawn(true));

        const scale = 1 / flake.z;
        const sx = vanishX + flake.x * scale * spread;
        const sy = vanishY + flake.y * scale * spread;
        if (sx < -0.1 || sx > 1.1 || sy < -0.1 || sy > 1.1) continue;

        const near = 1 - flake.z;
        const radius = (0.35 + near * near * 3.4) * flake.s * (1 + dive * 1.1);
        ctx.globalAlpha = Math.min(0.85, 0.1 + near * near * 0.9);
        ctx.beginPath();
        ctx.arc(sx * width, sy * height, radius, 0, Math.PI * 2);
        ctx.fill();
      }

      ctx.globalAlpha = 1;
      frame = window.requestAnimationFrame(draw);
    };

    const start = () => {
      if (active) return;
      active = true;
      frame = window.requestAnimationFrame(draw);
    };

    const stop = () => {
      active = false;
      window.cancelAnimationFrame(frame);
    };

    const onVisibility = () => {
      if (document.hidden) stop();
      else start();
    };

    resize();
    window.addEventListener('resize', resize, { passive: true });
    document.addEventListener('visibilitychange', onVisibility);
    start();

    return () => {
      stop();
      window.removeEventListener('resize', resize);
      document.removeEventListener('visibilitychange', onVisibility);
    };
  }
</script>
