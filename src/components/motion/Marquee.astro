---
interface Props {
  label: string;
  reverse?: boolean;
  pauseOnHover?: boolean;
  class?: string;
}

const { label, reverse = false, pauseOnHover = true, class: className } = Astro.props;
const items = label.split(/\s*·\s*/).filter(Boolean);
---

<div class:list={['marquee', reverse && 'marquee--reverse', pauseOnHover && 'marquee--pause', className]}>
  <div class="marquee__track">
    {
      [false, true].map((copy) => (
        <p class="label marquee__group" aria-hidden={copy ? 'true' : undefined}>
          <span>
            {
              items.map((item, index) => (
                <>
                  {index > 0 ? ' · ' : ''}
                  <span class="marquee__item">{item}</span>
                </>
              ))
            }
          </span>
        </p>
      ))
    }
  </div>
</div>
