---
export interface ReelClip {
  src: string;
  title: string;
  note: string;
  alt: string;
  poster?: string;
}

interface Props {
  label: string;
  reverse?: boolean;
  pauseOnHover?: boolean;
  clips?: ReelClip[];
  openTemplate?: string;
  class?: string;
}

const { label, reverse = false, pauseOnHover = false, clips, openTemplate, class: className } =
  Astro.props;
const items = label.split(/\s*·\s*/).filter(Boolean);
---

<div class:list={['marquee', reverse && 'marquee--reverse', pauseOnHover && 'marquee--pause', className]}>
  <div class="marquee__track">
    {
      [false, true].map((copy) => (
        <div class="label marquee__group" aria-hidden={copy ? 'true' : undefined}>
          <span>
            {
              items.map((item, index) => {
                const clip = clips?.[index];
                return (
                  <>
                    {index > 0 ? ' · ' : ''}
                    {clip ? (
                      <button
                        type="button"
                        class="label marquee__item"
                        data-reel
                        data-reel-src={clip.src}
                        data-reel-title={clip.title}
                        data-reel-note={clip.note}
                        data-reel-alt={clip.alt}
                        data-reel-poster={clip.poster}
                        aria-haspopup="dialog"
                        aria-controls="work-reel"
                        aria-label={openTemplate ? openTemplate.replace('{name}', item) : item}
                        tabindex={copy ? -1 : 0}
                      >
                        {item}
                      </button>
                    ) : (
                      <span class="label marquee__item">{item}</span>
                    )}
                  </>
                );
              })
            }
          </span>
        </div>
      ))
    }
  </div>
</div>
