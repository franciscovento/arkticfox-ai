---
import FrostField from '@/components/motion/FrostField.astro';
import Reveal from '@/components/motion/Reveal.astro';
import type { Locale } from '@/i18n/routes';
import type { UiKey } from '@/i18n/ui/en';
import { t } from '@/i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

/** `need` pre-ticks the matching box in the quote form when the card button is used. */
const cards: {
  need: string;
  eyebrow: UiKey;
  title: UiKey;
  emphasis: UiKey;
  body: UiKey;
  note?: UiKey;
}[] = [
  {
    need: 'product-images',
    eyebrow: 'page.productImages.heading',
    title: 'home.productTitle',
    emphasis: 'home.productEmphasis',
    body: 'home.productBody',
  },
  {
    need: 'ad-videos',
    eyebrow: 'page.adVideos.heading',
    title: 'home.adsTitle',
    emphasis: 'home.adsEmphasis',
    body: 'home.adsBody',
  },
  {
    need: 'ugc-videos',
    eyebrow: 'page.ugcVideos.heading',
    title: 'home.ugcTitle',
    emphasis: 'home.ugcEmphasis',
    body: 'home.ugcBody',
    note: 'home.ugcNote',
  },
];
---

<section
  class="relative isolate overflow-hidden px-5 py-20 md:px-10 md:py-28"
  aria-labelledby="services-title"
>
  <FrostField />
  <div class="relative z-10 mx-auto max-w-6xl">
    <Reveal>
      <h2
        id="services-title"
        class="max-w-3xl font-serif text-4xl leading-tight text-white md:text-6xl"
      >
        {t(locale, 'home.services.headlineLead')}{' '}
        <em class="italic">{t(locale, 'home.services.headlineEmphasis')}</em>.
      </h2>
    </Reveal>
    <div class="mt-10 grid gap-4 md:mt-14 md:grid-cols-3 md:gap-5">
      {
        cards.map((card, index) => (
          <Reveal stagger={index * 120} class="flex">
            <article class="glass sheen flex w-full flex-col gap-3 p-5 md:p-6" data-sheen>
              <p class="label text-ice-blue">{t(locale, card.eyebrow)}</p>
              <h3 class="font-serif text-3xl leading-tight text-white">
                <span class="block">{t(locale, card.title)}</span>
                <em class="mt-1 block italic">{t(locale, card.emphasis)}</em>
              </h3>
              <p class="font-sans text-sm leading-relaxed text-white/85">
                {t(locale, card.body)}
              </p>
              {card.note && (
                <p class="font-sans text-xs text-white/70">{t(locale, card.note)}</p>
              )}
              <a
                class="hover-fox mt-auto inline-flex w-fit items-center rounded-pill border border-white px-4 py-2.5 font-sans text-sm font-medium text-white"
                href="#contact"
                data-need={card.need}
              >
                {t(locale, 'nav.quote')}
              </a>
            </article>
          </Reveal>
        ))
      }
    </div>
  </div>
</section>
