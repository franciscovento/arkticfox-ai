---
import FrostField from '@/components/motion/FrostField.astro';
import GlassSheen from '@/components/motion/GlassSheen.astro';
import Reveal from '@/components/motion/Reveal.astro';
import SnowCanvas from '@/components/motion/SnowCanvas.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import type { Locale, PageKey } from '@/i18n/routes';
import type { UiKey } from '@/i18n/ui/en';
import { getPath, t } from '@/i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const nav: { pageKey: PageKey; label: UiKey }[] = [
  { pageKey: 'productImages', label: 'page.productImages.heading' },
  { pageKey: 'adVideos', label: 'page.adVideos.heading' },
  { pageKey: 'ugcVideos', label: 'page.ugcVideos.heading' },
];

const beats: {
  src: string;
  kind: 'image' | 'video';
  poster?: string;
  index: string;
  title: UiKey;
  cardTitle: UiKey;
  body: UiKey;
  side: 'start' | 'end';
  named?: boolean;
}[] = [
  {
    src: '/media/mocks/fashion-01.jpg',
    kind: 'image',
    index: '01',
    title: 'work.briefTitle',
    cardTitle: 'work.card1Title',
    body: 'work.brief',
    side: 'start',
    named: true,
  },
  {
    src: '/media/mocks/product-01.jpg',
    kind: 'image',
    index: '02',
    title: 'work.step2Title',
    cardTitle: 'work.card2Title',
    body: 'work.step2Body',
    side: 'end',
  },
  {
    src: '/media/mocks/reel-01.mp4',
    kind: 'video',
    poster: '/media/mocks/beauty-01.jpg',
    index: '03',
    title: 'work.step3Title',
    cardTitle: 'work.card3Title',
    body: 'work.step3Body',
    side: 'start',
  },
  {
    src: '/media/mocks/ugc-01.jpg',
    kind: 'image',
    index: '04',
    title: 'work.step4Title',
    cardTitle: 'work.card4Title',
    body: 'work.step4Body',
    side: 'end',
  },
];
---

<BaseLayout
  locale={locale}
  pageKey="work"
  title={t(locale, 'work.title')}
  description={t(locale, 'work.description')}
  noindex
  bodyClass="bg-polar-night"
>
  <FrostField fixed />
  <div class="work-snow" aria-hidden="true">
    <SnowCanvas />
  </div>
  <header class="relative z-20 flex items-center justify-between px-5 py-5 md:px-10">
    <nav class="hidden items-center gap-6 lg:flex" aria-label={t(locale, 'home.navLabel')}>
      {
        nav.map((item) => (
          <a class="label hover-fox text-white" href={getPath(locale, item.pageKey)}>
            {t(locale, item.label)}
          </a>
        ))
      }
    </nav>
    <a
      class="label text-white lg:absolute lg:left-1/2 lg:-translate-x-1/2"
      href={getPath(locale, 'home')}
    >
      {t(locale, 'meta.siteName')}
    </a>
    <div class="flex items-center gap-3 md:gap-5">
      <a
        class:list={['label hover-fox', locale === 'en' ? 'text-white' : 'text-white/70']}
        href={getPath('en', 'work')}
        hreflang="en"
        aria-current={locale === 'en' ? 'page' : undefined}
      >
        {t(locale, 'nav.languageEn')}
      </a>
      <a
        class:list={['label hover-fox', locale === 'es' ? 'text-white' : 'text-white/70']}
        href={getPath('es', 'work')}
        hreflang="es"
        aria-current={locale === 'es' ? 'page' : undefined}
      >
        {t(locale, 'nav.languageEs')}
      </a>
      <a
        class="hover-fox inline-flex items-center rounded-pill bg-brand-gradient px-4 py-2.5 font-sans text-xs font-medium text-white md:px-5 md:py-3 md:text-sm"
        href={getPath(locale, 'quote')}
      >
        {t(locale, 'nav.quote')}
      </a>
    </div>
  </header>

  <main class="relative z-10">
    <section class="work-beat work-beat--hero">
      <Reveal class="work-beat__intro">
        <p class="label text-ice-blue">{t(locale, 'work.eyebrow')}</p>
        <h1 class="mt-4 max-w-2xl font-serif text-4xl leading-none text-white md:text-6xl lg:text-7xl">
          {t(locale, 'work.heading')}
        </h1>
        <p class="mt-5 max-w-md font-sans text-sm leading-relaxed text-white/85 md:text-base">
          {t(locale, 'work.lead')}
        </p>
        <p class="label mt-8 text-ice-blue">{t(locale, 'work.process')}</p>
      </Reveal>
    </section>

    {
      beats.map((beat) => (
        <section class:list={['work-beat', `work-beat--${beat.side}`]}>
          <h2 class="work-beat__pin font-serif text-4xl italic text-white md:text-6xl">
            <span class="label not-italic text-ice-blue">{beat.index}</span>
            {t(locale, beat.title)}
          </h2>
          <figure
            class="work-beat__plate"
            transition:name={beat.named ? 'work-media' : undefined}
          >
            {beat.kind === 'video' ? (
              <video
                class="work-beat__media"
                src={beat.src}
                poster={beat.poster}
                muted
                loop
                playsinline
                autoplay
                data-work-loop
              ></video>
            ) : (
              <img
                class="work-beat__media"
                src={beat.src}
                alt={t(locale, beat.title)}
                width="1800"
                height="1200"
                loading={beat.named ? 'eager' : 'lazy'}
              />
            )}
            <div class="work-beat__scrim" aria-hidden="true"></div>
          </figure>
          <Reveal class:list={['work-beat__card-wrap', beat.side === 'end' && 'work-beat__card-wrap--end']}>
            <article class="glass sheen work-beat__card flex flex-col gap-3 p-5 md:p-6" data-sheen>
              <p class="label text-ice-blue">{beat.index}</p>
              <p class="font-serif text-2xl leading-tight text-white md:text-3xl">{t(locale, beat.cardTitle)}</p>
              <p class="font-sans text-sm leading-relaxed text-white/85">{t(locale, beat.body)}</p>
            </article>
          </Reveal>
        </section>
      ))
    }

    <section class="work-beat work-beat--close">
      <Reveal class="work-beat__intro">
        <p class="max-w-xl font-serif text-3xl leading-tight text-white md:text-5xl">{t(locale, 'work.note')}</p>
        <a
          class="hover-fox mt-6 inline-flex items-center rounded-pill border border-white px-6 py-3 font-sans text-sm font-medium text-white"
          href={getPath(locale, 'quote')}
        >
          {t(locale, 'nav.quote')}
        </a>
      </Reveal>
    </section>
  </main>
  <GlassSheen />
</BaseLayout>

<script>
  let pinObserver: IntersectionObserver | undefined;

  function bootWorkPins() {
    pinObserver?.disconnect();
    const pins = [...document.querySelectorAll<HTMLElement>('.work-beat__pin')];
    if (pins.length === 0) return;

    pinObserver = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          entry.target.classList.toggle('is-stuck', entry.intersectionRatio < 1);
        }
      },
      { threshold: [1], rootMargin: '-1px 0px 0px 0px' },
    );

    for (const pin of pins) pinObserver.observe(pin);
  }

  function bootWorkLoops() {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    for (const video of document.querySelectorAll<HTMLVideoElement>('[data-work-loop]')) {
      if (reduce) {
        video.pause();
        video.removeAttribute('autoplay');
        continue;
      }
      void video.play();
    }
  }

  document.addEventListener('astro:before-swap', () => pinObserver?.disconnect());
  document.addEventListener('astro:page-load', () => {
    bootWorkPins();
    bootWorkLoops();
  });
</script>
