---
import QuoteFab from '@/components/QuoteFab.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import QuoteForm from '@/components/home/QuoteForm.astro';
import VideoCarousel from '@/components/home/VideoCarousel.astro';
import GlassSheen from '@/components/motion/GlassSheen.astro';
import SnowDive from '@/components/motion/SnowDive.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import type { Locale, PageKey } from '@/i18n/routes';
import type { UiKey } from '@/i18n/ui/en';
import { t } from '@/i18n/utils';
import { readdirSync } from 'node:fs';
import { join } from 'node:path';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const pageKey: PageKey = 'home';

// The film is a still sequence in public/media/scrub, stepped with scroll.
const frameCount = readdirSync(join(process.cwd(), 'public/media/scrub')).filter((name) =>
  name.endsWith('.webp'),
).length;

const cards: {
  from: string;
  eyebrow: UiKey;
  title: UiKey;
  emphasis: UiKey;
  body: UiKey;
}[] = [
  {
    from: '0.66',
    eyebrow: 'page.productImages.heading',
    title: 'home.productTitle',
    emphasis: 'home.productEmphasis',
    body: 'home.productBody',
  },
  {
    from: '0.72',
    eyebrow: 'page.adVideos.heading',
    title: 'home.adsTitle',
    emphasis: 'home.adsEmphasis',
    body: 'home.adsBody',
  },
  {
    from: '0.78',
    eyebrow: 'page.ugcVideos.heading',
    title: 'home.ugcTitle',
    emphasis: 'home.ugcEmphasis',
    body: 'home.ugcBody',
  },
];

const avatarTag = t(locale, 'home.videoCard.tag');
const adTag = t(locale, 'home.carousel.adTag');

// Vertical films in public/media/projects. The carousel shuffles them on each visit.
const reelCards = [
  {
    src: '/media/projects/aurora-skin-cream-ugc.mp4',
    poster: '/media/projects/aurora-skin-cream-ugc.jpg',
    title: t(locale, 'home.reels.aurora.title'),
    description: t(locale, 'home.reels.aurora.body'),
    tag: avatarTag,
  },
  {
    src: '/media/projects/buick-2026-ugc.mp4',
    poster: '/media/projects/buick-2026-ugc.jpg',
    title: t(locale, 'home.reels.buick.title'),
    description: t(locale, 'home.reels.buick.body'),
    tag: avatarTag,
  },
  {
    src: '/media/projects/cadillac-driver-seat-ugc.mp4',
    poster: '/media/projects/cadillac-driver-seat-ugc.jpg',
    title: t(locale, 'projects.piece.driver'),
    description: t(locale, 'home.carousel.driverBody'),
    tag: avatarTag,
  },
  {
    src: '/media/projects/cadillac-year-end-deals.mp4',
    poster: '/media/projects/cadillac-year-end-deals.jpg',
    title: t(locale, 'projects.piece.deals'),
    description: t(locale, 'home.carousel.dealsBody'),
    tag: adTag,
  },
  {
    src: '/media/projects/jeep-creator-to-camera-ugc.mp4',
    poster: '/media/projects/jeep-creator-to-camera-ugc.jpg',
    title: t(locale, 'home.videoCard.title'),
    description: t(locale, 'home.videoCard.body'),
    tag: avatarTag,
  },
  {
    src: '/media/projects/kia-dealership-pov-ugc.mp4',
    poster: '/media/projects/kia-dealership-pov-ugc.jpg',
    title: t(locale, 'home.reels.kiaPov.title'),
    description: t(locale, 'home.reels.kiaPov.body'),
    tag: avatarTag,
  },
  {
    src: '/media/projects/kia-suv-lineup.mp4',
    poster: '/media/projects/kia-suv-lineup.jpg',
    title: t(locale, 'home.reels.kiaLineup.title'),
    description: t(locale, 'home.reels.kiaLineup.body'),
    tag: adTag,
  },
  {
    src: '/media/projects/subaru-forester-camping-ugc.mp4',
    poster: '/media/projects/subaru-forester-camping-ugc.jpg',
    title: t(locale, 'home.reels.forester.title'),
    description: t(locale, 'home.reels.forester.body'),
    tag: avatarTag,
  },
  {
    src: '/media/projects/subaru-outdoor-ugc.mp4',
    poster: '/media/projects/subaru-outdoor-ugc.jpg',
    title: t(locale, 'home.reels.subaru.title'),
    description: t(locale, 'home.reels.subaru.body'),
    tag: avatarTag,
  },
  {
    src: '/media/projects/ugc-creator-camera-tap.mp4',
    poster: '/media/projects/ugc-creator-camera-tap.jpg',
    title: t(locale, 'home.reels.tap.title'),
    description: t(locale, 'home.reels.tap.body'),
    tag: avatarTag,
  },
];
---

<BaseLayout
  locale={locale}
  pageKey={pageKey}
  title={t(locale, 'meta.homeTitle')}
  description={t(locale, 'meta.homeDescription')}
  bodyClass="bg-polar-night"
>
  <main>
  <div data-snow-dive class="relative">
    <div
      class="fixed inset-0 z-50 flex flex-col items-center justify-center gap-8 bg-polar-night"
      data-loader
      role="status"
    >
      <p class="label text-white">{t(locale, 'meta.siteName')}</p>
      <div class="h-px w-36 overflow-hidden bg-glass-border" aria-hidden="true">
        <div class="h-full w-full bg-white" data-loader-bar></div>
      </div>
      <p class="sr-only">{t(locale, 'home.loading')}</p>
    </div>

    <SiteHeader locale={locale} pageKey={pageKey} fixed />

    <div class="relative z-20 min-h-svh" data-journey-stage>
      <canvas
        class="pointer-events-none absolute inset-0 z-0 h-full w-full"
        data-scrub-frames
        data-frame-base="/media/scrub/frame-"
        data-frame-count={frameCount}
        aria-hidden="true"
      />
      <div class="video-shade bg-video-shade" aria-hidden="true"></div>
      <div
        class="drift-veil bg-dive-veil"
        data-dive-veil
        aria-hidden="true"
      ></div>
      {/* Snow direction: "fall" drops from the top. "dive" restores the head-on rush. */}
      <canvas
        class="pointer-events-none absolute inset-0 z-10 h-full w-full"
        data-dive-snow
        data-snow-direction="fall"
        aria-hidden="true"
      ></canvas>
      <div
        class="z-20 flex flex-col justify-end px-5 pt-28 pb-16 md:justify-center md:px-16"
        data-journey-beat
        data-from="0"
        data-to="0.22"
      >
        <p class="label text-ice-blue">{t(locale, 'home.eyebrow')}</p>
        <h1 class="mt-4 max-w-3xl font-serif text-4xl leading-tight text-white md:text-5xl lg:text-6xl">
          <span class="block">
            {t(locale, 'home.line1Lead')}{' '}
            <em class="italic">{t(locale, 'home.line1Emphasis')}</em>.
          </span>
          <span class="block">
            {t(locale, 'home.line2Lead')}{' '}
            <em class="italic">{t(locale, 'home.line2Emphasis')}</em>.
          </span>
        </h1>
        <p class="mt-5 max-w-md font-sans text-sm leading-relaxed text-white/85 md:text-base">
          {t(locale, 'home.subhead')}
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a
            class="hover-fox inline-flex items-center rounded-pill bg-brand-gradient px-6 py-3 font-sans text-sm font-medium text-white"
            href="#contact"
            data-quote-jump
          >
            {t(locale, 'nav.quote')}
          </a>
        </div>
      </div>
      {/* Reels: slide in from the side after the hero and hold for a long stretch of scroll. */}
      <div class="z-20 flex items-center justify-center pt-20" data-journey-row>
        <div
          class="w-full"
          data-journey-piece
          data-enter="side"
          data-from="0.2"
          data-to="0.62"
          data-fade="0.08"
        >
          <VideoCarousel
            items={reelCards}
            label={t(locale, 'home.carousel.label')}
            prevLabel={t(locale, 'home.carousel.prev')}
            nextLabel={t(locale, 'home.carousel.next')}
            soundOnLabel={t(locale, 'home.videoCard.soundOn')}
            soundOffLabel={t(locale, 'home.videoCard.soundOff')}
            pauseLabel={t(locale, 'home.videoCard.pause')}
            playLabel={t(locale, 'home.videoCard.play')}
          />
        </div>
      </div>
      <div
        class="z-20 flex items-center justify-center px-4 pt-28 pb-8 md:px-10"
        data-journey-row
      >
        <div class="flex w-full flex-col items-stretch justify-center gap-3 md:w-auto md:flex-row md:gap-5">
          {cards.map((card) => (
            <article
              class="glass sheen journey-piece flex flex-col gap-3 p-4 md:p-5"
              data-journey-piece
              data-sheen
              data-from={card.from}
            >
              <p class="label text-ice-blue">{t(locale, card.eyebrow)}</p>
              <h2 class="font-serif text-2xl leading-tight text-white md:text-3xl">
                <span class="block">{t(locale, card.title)}</span>
                <em class="mt-1 block italic">{t(locale, card.emphasis)}</em>
              </h2>
              <p class="hidden font-sans text-xs leading-relaxed text-white/85 md:block md:text-sm">
                {t(locale, card.body)}
              </p>
              <span
                class="mt-auto inline-flex w-fit items-center rounded-pill border border-white px-4 py-2.5 font-sans text-xs font-medium text-white md:text-sm"
              >
                {t(locale, card.eyebrow)}
              </span>
            </article>
          ))}
        </div>
      </div>
    </div>
  </div>
  </main>
  <QuoteForm locale={locale} />
  <QuoteFab locale={locale} />
  <SnowDive />
  <GlassSheen />
</BaseLayout>

<script>
  import { onPageReady } from '../../motion/ready';

  // The first visit shows the loader while the first frames arrive (SnowDive closes it).
  // Coming back from another page the frames are cached, so close it straight away.
  let firstLoad = true;
  const onPage = () => {
    const loader = document.querySelector<HTMLElement>('[data-loader]');
    if (!firstLoad && loader) {
      loader.classList.add('is-done');
      loader.setAttribute('aria-hidden', 'true');
    }
    firstLoad = false;
  };
  onPageReady(onPage);
</script>
