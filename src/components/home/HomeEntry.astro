---
import SiteHeader from '@/components/chrome/SiteHeader.astro';
import HomeRest from '@/components/home/HomeRest.astro';
import GlassSheen from '@/components/motion/GlassSheen.astro';
import WorkReel from '@/components/home/WorkReel.astro';
import Marquee from '@/components/motion/Marquee.astro';
import SnowDive from '@/components/motion/SnowDive.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import type { Locale, PageKey } from '@/i18n/routes';
import type { UiKey } from '@/i18n/ui/en';
import { getPath, t } from '@/i18n/utils';
import { readdirSync } from 'node:fs';
import { join } from 'node:path';

interface Props {
  locale: Locale;
  /** `loop` is the home film. `scrub` is the /v2 still sequence tied to scroll. */
  variant?: 'loop' | 'scrub';
}

const { locale, variant = 'loop' } = Astro.props;
const scrub = variant === 'scrub';
const pageKey: PageKey = scrub ? 'homeV2' : 'home';

const frameCount = scrub
  ? readdirSync(join(process.cwd(), 'public/media/scrub')).filter((name) =>
      name.endsWith('.webp'),
    ).length
  : 0;

const cards: {
  from: string;
  pageKey: PageKey;
  eyebrow: UiKey;
  title: UiKey;
  emphasis: UiKey;
  body: UiKey;
}[] = [
  {
    from: '0.32',
    pageKey: 'productImages',
    eyebrow: 'page.productImages.heading',
    title: 'home.productTitle',
    emphasis: 'home.productEmphasis',
    body: 'home.productBody',
  },
  {
    from: '0.4',
    pageKey: 'adVideos',
    eyebrow: 'page.adVideos.heading',
    title: 'home.adsTitle',
    emphasis: 'home.adsEmphasis',
    body: 'home.adsBody',
  },
  {
    from: '0.48',
    pageKey: 'ugcVideos',
    eyebrow: 'page.ugcVideos.heading',
    title: 'home.ugcTitle',
    emphasis: 'home.ugcEmphasis',
    body: 'home.ugcBody',
  },
];

const sectorClips = [
  '/media/mocks/product-01.jpg',
  '/media/mocks/fashion-01.jpg',
  '/media/mocks/beauty-01.jpg',
  '/media/mocks/food-01.jpg',
  '/media/mocks/reel-02.mp4',
];

const serviceClips = [
  '/media/mocks/product-03.jpg',
  '/media/mocks/reel-01.mp4',
  '/media/mocks/ugc-01.jpg',
];
---

<BaseLayout
  locale={locale}
  pageKey={pageKey}
  title={t(locale, scrub ? 'home.v2.title' : 'meta.homeTitle')}
  description={t(
    locale,
    scrub ? 'home.v2.description' : 'meta.homeDescription',
  )}
  noindex={scrub}
  bodyClass="bg-polar-night"
>
  <div id="content" data-snow-dive class="relative">
    <SiteHeader locale={locale} pageKey={pageKey} />
    <div
      class="fixed inset-0 z-50 flex flex-col items-center justify-center gap-8 bg-polar-night"
      data-loader
      role="status"
    >
      <p class="label text-white">{t(locale, 'meta.siteName')}</p>
      <div class="h-px w-36 overflow-hidden bg-glass-border" aria-hidden="true">
        <div class="h-full w-full bg-white" data-loader-bar></div>
      </div>
      <p class="sr-only">{t(locale, 'home.loading')}</p>
    </div>

    <div class="relative z-20 min-h-svh" data-journey-stage>
      {scrub ? (
        <canvas
          class="pointer-events-none absolute inset-0 z-0 h-full w-full"
          data-scrub-frames
          data-frame-base="/media/scrub/frame-"
          data-frame-count={frameCount}
          aria-hidden="true"
        />
      ) : (
        <video
          class="pointer-events-none absolute inset-0 z-0 h-full w-full object-cover"
          data-dive-video
          src="/media/hero-loop.mp4?v=2"
          poster="/media/hero-loop.jpg?v=2"
          muted
          loop
          playsinline
          preload="auto"
          disablepictureinpicture
          aria-hidden="true"
        />
      )}
      <div class="video-shade bg-video-shade" aria-hidden="true"></div>
      <div
        class="drift-veil bg-dive-veil"
        data-dive-veil
        aria-hidden="true"
      ></div>
      {/* Snow direction: "fall" drops from the top. "dive" restores the head-on rush. */}
      <canvas
        class="pointer-events-none absolute inset-0 z-10 h-full w-full"
        data-dive-snow
        data-snow-direction="fall"
        aria-hidden="true"
      ></canvas>
      <div
        class="z-20 flex flex-col justify-end px-5 pt-28 pb-16 md:justify-center md:px-16"
        data-journey-beat
        data-from="0"
        data-to="0.28"
      >
        <p class="label text-ice-blue">{t(locale, 'home.eyebrow')}</p>
        <h1 class="mt-4 max-w-3xl font-serif text-4xl leading-tight text-white md:text-5xl lg:text-6xl">
          <span class="block">
            {t(locale, 'home.line1Lead')}{' '}
            <em class="italic">{t(locale, 'home.line1Emphasis')}</em>,
          </span>
          <span class="block">
            {t(locale, 'home.line2Lead')}{' '}
            <em class="italic">{t(locale, 'home.line2Emphasis')}</em>.
          </span>
        </h1>
        <p class="mt-5 max-w-md font-sans text-sm leading-relaxed text-white/85 md:text-base">
          {t(locale, 'home.subhead')}
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a
            class="hover-fox inline-flex items-center rounded-pill bg-brand-gradient px-6 py-3 font-sans text-sm font-medium text-white"
            href={getPath(locale, 'quote')}
          >
            {t(locale, 'nav.quote')}
          </a>
          <a
            class="hover-fox inline-flex items-center rounded-pill border border-white px-6 py-3 font-sans text-sm font-medium text-white"
            href={`${getPath(locale, 'home')}#work`}
          >
            {t(locale, 'shared.cta.work')}
          </a>
        </div>
      </div>
      <div
        class="z-20 flex items-center justify-center px-4 pt-28 pb-8 md:px-10"
        data-journey-row
      >
        <div class="flex w-full flex-col items-stretch justify-center gap-3 md:w-auto md:flex-row md:gap-5">
          {cards.map((card) => (
            <article
              class="glass sheen journey-piece flex flex-col gap-3 p-4 md:p-5"
              data-journey-piece
              data-sheen
              data-from={card.from}
              data-to="0.76"
            >
              <p class="label text-ice-blue">{t(locale, card.eyebrow)}</p>
              <h2 class="font-serif text-2xl leading-tight text-white md:text-3xl">
                <span class="block">{t(locale, card.title)}</span>
                <em class="mt-1 block italic">{t(locale, card.emphasis)}</em>
              </h2>
              <p class="hidden font-sans text-xs leading-relaxed text-white/85 md:block md:text-sm">
                {t(locale, card.body)}
              </p>
              <a
                class="hover-fox mt-auto inline-flex w-fit items-center rounded-pill border border-white px-4 py-2.5 font-sans text-xs font-medium text-white md:text-sm"
                href={getPath(locale, card.pageKey)}
              >
                {t(locale, card.eyebrow)}
              </a>
            </article>
          ))}
        </div>
      </div>
      <div
        class="z-20 flex flex-col justify-center"
        data-journey-beat
        data-from="0.74"
        data-to="1"
      >
        <div class="flex flex-col gap-2">
          <Marquee
            class="text-white"
            label={t(locale, 'home.marquee.label')}
            clips={sectorClips}
            openTemplate={t(locale, 'home.reel.open')}
            pauseOnHover={false}
          />
          <Marquee
            class="text-white/70"
            label={t(locale, 'home.marquee.services')}
            clips={serviceClips}
            openTemplate={t(locale, 'home.reel.open')}
            reverse
            pauseOnHover={false}
          />
        </div>
        <p
          class="pointer-events-none absolute right-5 bottom-8 label text-ice-blue md:right-10 md:bottom-10"
          data-marquee-hint
        >
          {t(locale, 'home.marquee.hint')}
        </p>
      </div>
    </div>
  </div>
  <HomeRest locale={locale} pageKey={pageKey} />
  <WorkReel
    closeLabel={t(locale, 'home.reel.close')}
    note={t(locale, 'home.reel.note')}
    moreLabel={t(locale, 'home.reel.more')}
    moreHref={getPath(locale, 'work')}
    poster="/media/mocks/fashion-01.jpg"
  />
  <SnowDive />
  <GlassSheen />
</BaseLayout>

<script>
  import { onPageReady } from '../../motion/ready';

  function bootHomeEntry() {
    const root = document.querySelector<HTMLElement>('[data-snow-dive]');
    if (!root || root.dataset.booted === 'true') return;
    root.dataset.booted = 'true';

    const loader = root.querySelector<HTMLElement>('[data-loader]');
    const bar = root.querySelector<HTMLElement>('[data-loader-bar]');
    if (!loader || !bar) return;
    if (root.querySelector('[data-scrub-frames]')) return;

    const finish = () => {
      loader.classList.add('is-done');
      loader.setAttribute('aria-hidden', 'true');
    };

    bar.style.transform = 'scaleX(1)';
    window.setTimeout(
      finish,
      window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 0 : 280,
    );
  }

  let firstLoad = true;
  const onPage = () => {
    bootHomeEntry();
    const loader = document.querySelector<HTMLElement>('[data-loader]');
    if (!firstLoad && loader) {
      loader.classList.add('is-done');
      loader.setAttribute('aria-hidden', 'true');
    }
    firstLoad = false;
  };
  onPageReady(onPage);
</script>
