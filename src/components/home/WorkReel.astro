---
interface Props {
  closeLabel: string;
  moreLabel: string;
  moreHref: string;
}

const { closeLabel, moreLabel, moreHref } = Astro.props;
---

<dialog class="work-reel" id="work-reel" data-work-reel aria-labelledby="work-reel-title">
  <div class="work-reel__frame glass sheen" data-sheen>
    <div class="work-reel__bar">
      <h2 class="label text-white" id="work-reel-title" data-reel-heading>&nbsp;</h2>
      <button type="button" class="label hover-fox text-white" data-reel-close>{closeLabel}</button>
    </div>
    <div class="work-reel__media bg-ink">
      <video
        class="work-reel__shot"
        data-reel-video
        muted
        playsinline
        preload="none"
        controls
        hidden
      ></video>
      <img class="work-reel__shot" data-reel-image alt="" hidden />
    </div>
    <div class="work-reel__meta">
      <p class="work-reel__note font-sans text-xs text-white/70" data-reel-note></p>
      <a
        class="hover-fox inline-flex items-center rounded-pill border border-white px-4 py-2 font-sans text-xs font-medium text-white"
        href={moreHref}
        data-reel-more
      >
        {moreLabel}
      </a>
    </div>
  </div>
</dialog>

<script>
  import { onPageReady } from '../../motion/ready';

  let bound = false;

  function reelNodes() {
    const dialog = document.querySelector<HTMLDialogElement>('[data-work-reel]');
    const video = dialog?.querySelector<HTMLVideoElement>('[data-reel-video]');
    const image = dialog?.querySelector<HTMLImageElement>('[data-reel-image]');
    const heading = dialog?.querySelector<HTMLElement>('[data-reel-heading]');
    const note = dialog?.querySelector<HTMLElement>('[data-reel-note]');
    return { dialog, video, image, heading, note };
  }

  function isVideo(src: string) {
    return /\.(mp4|webm|mov)(\?|$)/i.test(src);
  }

  function reduce() {
    return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  }

  function clearMedia() {
    const { video, image } = reelNodes();
    if (video) {
      video.pause();
      video.removeAttribute('src');
      video.load();
      video.hidden = true;
    }
    if (image) {
      image.removeAttribute('src');
      image.alt = '';
      image.hidden = true;
    }
  }

  function closeNow() {
    const { dialog } = reelNodes();
    if (!dialog) return;
    dialog.classList.remove('is-open');
    clearMedia();
    if (dialog.open) dialog.close();
  }

  function requestClose() {
    const { dialog } = reelNodes();
    if (!dialog?.open) return;
    dialog.classList.remove('is-open');
    const finish = () => {
      clearMedia();
      if (dialog.open) dialog.close();
    };
    if (reduce()) {
      finish();
      return;
    }
    const onEnd = (event: TransitionEvent) => {
      if (event.target !== dialog || event.propertyName !== 'opacity') return;
      dialog.removeEventListener('transitionend', onEnd);
      finish();
    };
    dialog.addEventListener('transitionend', onEnd);
  }

  function open(src: string, title: string, note: string, alt: string, poster: string) {
    const nodes = reelNodes();
    const { dialog, video, image, heading } = nodes;
    if (!dialog || !video || !image || !heading) return;
    heading.textContent = title;
    if (nodes.note) nodes.note.textContent = note;
    if (isVideo(src)) {
      image.hidden = true;
      video.hidden = false;
      video.poster = poster;
      video.preload = 'none';
      video.src = src;
    } else {
      video.hidden = true;
      video.removeAttribute('poster');
      image.hidden = false;
      image.src = src;
      image.alt = alt || title;
    }
    dialog.showModal();
    requestAnimationFrame(() => dialog.classList.add('is-open'));
    if (isVideo(src) && !reduce()) {
      video.loop = true;
      void video.play();
    }
  }

  function bootWorkReel() {
    if (bound) return;
    bound = true;

    document.addEventListener('click', (event) => {
      const target = event.target as HTMLElement | null;
      if (target?.closest('[data-reel-more]')) {
        closeNow();
        return;
      }
      if (target?.closest('[data-reel-close]')) {
        requestClose();
        return;
      }
      const trigger = target?.closest<HTMLElement>('[data-reel]');
      if (!trigger) return;
      event.preventDefault();
      const src = trigger.dataset.reelSrc;
      if (!src) return;
      open(
        src,
        trigger.dataset.reelTitle ?? '',
        trigger.dataset.reelNote ?? '',
        trigger.dataset.reelAlt ?? '',
        trigger.dataset.reelPoster ?? '',
      );
    });

    document.addEventListener('click', (event) => {
      const { dialog } = reelNodes();
      if (event.target === dialog) requestClose();
    });

    document.addEventListener('cancel', (event) => {
      if (!(event.target instanceof HTMLDialogElement) || event.target !== reelNodes().dialog) return;
      event.preventDefault();
      requestClose();
    });
  }

  onPageReady(bootWorkReel);
</script>
