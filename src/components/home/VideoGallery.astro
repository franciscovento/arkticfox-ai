---
import Reveal from '@/components/motion/Reveal.astro';
import type { Locale } from '@/i18n/routes';
import type { UiKey } from '@/i18n/ui/en';
import { t } from '@/i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

/**
 * Stand-in pieces from the existing project media. Swap `src`/`poster` and the two text keys
 * when the final reels arrive. `avatar` marks AI-avatar UGC, which keeps the transparency note.
 */
const clips: {
  src: string;
  poster: string;
  ratio: 'square' | 'story';
  title: UiKey;
  alt: UiKey;
  avatar?: boolean;
}[] = [
  {
    src: '/media/projects/cadillac-1.mp4',
    poster: '/media/projects/cadillac-1.jpg',
    ratio: 'square',
    title: 'projects.piece.lyriq',
    alt: 'projects.piece.lyriqAlt',
  },
  {
    src: '/media/projects/cadillac-2.mp4',
    poster: '/media/projects/cadillac-2.jpg',
    ratio: 'story',
    title: 'projects.piece.deals',
    alt: 'projects.piece.dealsAlt',
  },
  {
    src: '/media/projects/cadillac-ugc.mp4',
    poster: '/media/projects/cadillac-ugc.jpg',
    ratio: 'story',
    title: 'projects.piece.driver',
    alt: 'projects.piece.driverAlt',
    avatar: true,
  },
  {
    src: '/media/projects/jeep-ugc.mp4',
    poster: '/media/projects/jeep-ugc.jpg',
    ratio: 'story',
    title: 'projects.piece.jeep',
    alt: 'projects.piece.jeepAlt',
    avatar: true,
  },
];

const hasAvatar = clips.some((clip) => clip.avatar);
---

<section
  class="relative bg-polar-night px-5 py-20 md:px-10 md:py-28"
  aria-labelledby="gallery-title"
  data-gallery
>
  <div class="mx-auto max-w-6xl">
    <Reveal>
      <p class="label text-ice-blue">{t(locale, 'gallery.eyebrow')}</p>
      <h2
        id="gallery-title"
        class="mt-4 max-w-3xl font-serif text-4xl leading-tight text-white md:text-6xl"
      >
        {t(locale, 'gallery.headingLead')}{' '}
        <em class="italic">{t(locale, 'gallery.headingEmphasis')}</em>.
      </h2>
    </Reveal>
  </div>

  <Reveal class="mt-10 md:mt-14">
    <ul class="-mx-5 flex snap-x snap-mandatory items-end gap-4 overflow-x-auto px-5 pb-4 md:-mx-10 md:px-10 lg:mx-0 lg:justify-center lg:overflow-visible lg:px-0">
      {clips.map((clip) => (
        <li class="shrink-0 snap-start">
          <figure>
            <div
              class:list={[
                'h-[21.5rem] overflow-hidden rounded-card-sm border border-glass-border bg-ink sm:h-[26rem] lg:h-[28rem]',
                clip.ratio === 'square' ? 'aspect-square' : 'aspect-[9/16]',
              ]}
            >
              <video
                class="h-full w-full object-cover"
                poster={clip.poster}
                muted
                loop
                playsinline
                controls
                preload="none"
                data-gallery-video
                aria-label={t(locale, clip.alt)}
              >
                <source src={clip.src} type="video/mp4" />
                {t(locale, clip.title)}
              </video>
            </div>
            <figcaption class="mt-3 font-sans text-sm text-white/85">
              {t(locale, clip.title)}
            </figcaption>
          </figure>
        </li>
      ))}
    </ul>
    {
      hasAvatar && (
        <p class="mx-auto mt-6 max-w-6xl font-sans text-xs text-white/70">
          {t(locale, 'projects.ugcNote')}
        </p>
      )
    }
  </Reveal>
</section>

<script>
  import { onPageReady } from '../../motion/ready';
  import { prefersReducedMotion } from '../../motion/reduced';

  let observer: IntersectionObserver | undefined;

  /** Plays a clip while most of it is on screen. A clip the visitor paused stays paused. */
  function bootGallery() {
    observer?.disconnect();
    const videos = [...document.querySelectorAll<HTMLVideoElement>('[data-gallery-video]')];
    if (videos.length === 0 || prefersReducedMotion()) return;

    for (const video of videos) {
      video.addEventListener('pause', () => {
        if (video.dataset.driving !== 'true') video.dataset.hold = 'true';
      });
      video.addEventListener('play', () => {
        if (video.dataset.driving !== 'true') delete video.dataset.hold;
      });
    }

    observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const video = entry.target as HTMLVideoElement;
          video.dataset.driving = 'true';
          if (entry.isIntersecting) {
            if (video.dataset.hold !== 'true') void video.play().catch(() => {});
          } else {
            video.pause();
          }
          video.dataset.driving = 'false';
        }
      },
      { threshold: 0.45 },
    );
    for (const video of videos) observer.observe(video);
  }

  document.addEventListener('astro:before-swap', () => observer?.disconnect());
  onPageReady(bootGallery);
</script>
