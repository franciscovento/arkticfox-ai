---
import SiteFooter from '@/components/chrome/SiteFooter.astro';
import CompareSlider from '@/components/sections/CompareSlider.astro';
import FaqList from '@/components/sections/FaqList.astro';
import FinalCta from '@/components/sections/FinalCta.astro';
import Gallery from '@/components/sections/Gallery.astro';
import PackageCards from '@/components/sections/PackageCards.astro';
import ProcessSteps from '@/components/sections/ProcessSteps.astro';
import { homeFaq } from '@/lib/catalog';
import type { Locale, PageKey } from '@/i18n/routes';
import type { UiKey } from '@/i18n/ui/en';
import { getPath, t } from '@/i18n/utils';

interface Props {
  locale: Locale;
  pageKey: PageKey;
}

const { locale, pageKey } = Astro.props;

const panels: {
  pageKey: PageKey;
  eyebrow: UiKey;
  title: UiKey;
  emphasis: UiKey;
  body: UiKey;
  src: string;
  poster: string;
  alt: UiKey;
}[] = [
  {
    pageKey: 'productImages',
    eyebrow: 'page.productImages.heading',
    title: 'home.productTitle',
    emphasis: 'home.productEmphasis',
    body: 'home.productBody',
    src: '/media/clips/clip-fox-on-snowdrift.mp4',
    poster: '/media/clips/clip-fox-on-snowdrift-poster.jpg',
    alt: 'media.clipDriftAlt',
  },
  {
    pageKey: 'adVideos',
    eyebrow: 'page.adVideos.heading',
    title: 'home.adsTitle',
    emphasis: 'home.adsEmphasis',
    body: 'home.adsBody',
    src: '/media/clips/tunnel-cloud-reveal.mp4',
    poster: '/media/clips/tunnel-cloud-reveal-poster.jpg',
    alt: 'media.clipCloudAlt',
  },
  {
    pageKey: 'ugcVideos',
    eyebrow: 'page.ugcVideos.heading',
    title: 'home.ugcTitle',
    emphasis: 'home.ugcEmphasis',
    body: 'home.ugcBody',
    src: '/media/clips/clip-fox-back-view.mp4',
    poster: '/media/clips/clip-fox-back-view-poster.jpg',
    alt: 'media.clipBackAlt',
  },
];

const why: { title: UiKey; body: UiKey; line: string }[] = [
  {
    title: 'home.why.speedTitle',
    body: 'home.why.speedBody',
    line: 'border-ice-blue',
  },
  {
    title: 'home.why.costTitle',
    body: 'home.why.costBody',
    line: 'border-fox-coral',
  },
  {
    title: 'home.why.testingTitle',
    body: 'home.why.testingBody',
    line: 'border-fox-pink',
  },
  {
    title: 'home.why.qualityTitle',
    body: 'home.why.qualityBody',
    line: 'border-snow-gray',
  },
];

const galleryItems = [
  {
    src: '/media/brand/fox-leaping-tunnel.webp',
    kind: 'image' as const,
    alt: 'media.foxLeapingAlt' as UiKey,
    sector: 'studio' as const,
    service: 'product' as const,
    caption: 'media.foxLeapingAlt' as UiKey,
  },
  {
    src: '/media/brand/fox-peeking-snow-4x3.webp',
    kind: 'image' as const,
    alt: 'media.foxPeek43Alt' as UiKey,
    sector: 'studio' as const,
    service: 'product' as const,
    caption: 'media.foxPeek43Alt' as UiKey,
  },
  {
    src: '/media/clips/tunnel-fox-ref-a.mp4',
    poster: '/media/clips/tunnel-fox-ref-a-poster.jpg',
    kind: 'video' as const,
    alt: 'media.clipTunnelAAlt' as UiKey,
    sector: 'studio' as const,
    service: 'ads' as const,
    caption: 'media.clipTunnelAAlt' as UiKey,
  },
  {
    src: '/media/clips/clip-fox-peek-closeup.mp4',
    poster: '/media/clips/clip-fox-peek-closeup-poster.jpg',
    kind: 'video' as const,
    alt: 'media.clipPeekAlt' as UiKey,
    sector: 'studio' as const,
    service: 'ugc' as const,
    caption: 'media.clipPeekAlt' as UiKey,
  },
  {
    src: '/media/clips/clip-sunrise-snow.mp4',
    poster: '/media/clips/clip-sunrise-snow-poster.jpg',
    kind: 'video' as const,
    alt: 'media.clipSunriseAlt' as UiKey,
    sector: 'studio' as const,
    service: 'ads' as const,
    caption: 'media.clipSunriseAlt' as UiKey,
  },
  {
    src: '/media/brand/snow-tunnel-empty.webp',
    kind: 'image' as const,
    alt: 'media.tunnelEmptyAlt' as UiKey,
    sector: 'studio' as const,
    service: 'product' as const,
    caption: 'media.tunnelEmptyAlt' as UiKey,
  },
];
---

<div class="relative z-20 bg-snow-white">
  <section
    id="services"
    class="bg-polar-night px-5 py-20 text-white md:px-10 md:py-28"
  >
    <div class="mx-auto max-w-6xl">
      <p class="label text-ice-blue">{t(locale, 'home.services.eyebrow')}</p>
      <h2 class="mt-4 max-w-xl font-serif text-4xl md:text-6xl">
        {t(locale, 'home.services.headlineLead')}{' '}
        <em class="italic">{t(locale, 'home.services.headlineEmphasis')}</em>.
      </h2>
      <div class="mt-10 grid gap-4 lg:grid-cols-3">
        {panels.map((panel) => (
          <article
            class="hover-card relative isolate min-h-80 overflow-hidden rounded-card"
            data-hover-card
          >
            <img
              class="absolute inset-0 h-full w-full object-cover"
              src={panel.poster}
              alt=""
            />
            <video
              class="absolute inset-0 h-full w-full object-cover"
              muted
              playsinline
              loop
              poster={panel.poster}
              preload="none"
              aria-label={t(locale, panel.alt)}
            >
              <source src={panel.src} type="video/mp4" />
            </video>
            <div class="absolute inset-0 bg-hero-scrim-bottom"></div>
            <div class="relative flex min-h-80 flex-col justify-end gap-3 p-6">
              <p class="label text-ice-blue">{t(locale, panel.eyebrow)}</p>
              <h3 class="font-serif text-3xl leading-tight">
                <span class="block">{t(locale, panel.title)}</span>
                <em class="italic">{t(locale, panel.emphasis)}</em>
              </h3>
              <p class="font-sans text-sm leading-relaxed text-white/85">
                {t(locale, panel.body)}
              </p>
              {panel.pageKey === 'ugcVideos' && (
                <p class="font-sans text-xs text-white/80">
                  {t(locale, 'home.ugcNote')}
                </p>
              )}
              <a
                class="hover-fox mt-auto inline-flex w-fit items-center rounded-pill border border-white px-4 py-2 font-sans text-sm text-white"
                href={getPath(locale, panel.pageKey)}
              >
                {t(locale, 'shared.cta.explore')}
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-snow-white px-5 py-20 md:px-10 md:py-28">
    <div class="mx-auto max-w-6xl">
      <CompareSlider
        locale={locale}
        before="/media/brand/snow-tunnel-empty.webp"
        after="/media/brand/fox-in-snow-tunnel.webp"
        beforeAlt={t(locale, 'media.tunnelEmptyAlt')}
        afterAlt={t(locale, 'media.foxInTunnelAlt')}
        headlineLead="home.beforeAfter.headlineLead"
        headlineEmphasis="home.beforeAfter.headlineEmphasis"
      />
    </div>
  </section>

  <section class="bg-snow-white px-5 pb-20 md:px-10 md:pb-28">
    <div class="mx-auto max-w-6xl">
      <h2 class="font-serif text-4xl text-ink md:text-6xl">
        {t(locale, 'home.why.eyebrow')}
      </h2>
      <ul class="mt-10 grid gap-4 md:grid-cols-2 lg:grid-cols-4">
        {why.map((item) => (
          <li class:list={['rounded-card border-t-2 bg-white p-5', item.line]}>
            <h3 class="font-serif text-2xl text-ink">
              {t(locale, item.title)}
            </h3>
            <p class="mt-3 font-sans text-sm leading-relaxed text-ink">
              {t(locale, item.body)}
            </p>
          </li>
        ))}
      </ul>
      <a
        class="hover-fox mt-8 inline-flex items-center rounded-pill bg-brand-gradient px-6 py-3 font-sans text-sm font-medium text-white"
        href={getPath(locale, 'quote')}
      >
        {t(locale, 'shared.cta.quote')}
      </a>
    </div>
  </section>

  <Gallery
    locale={locale}
    items={galleryItems}
    showServiceFilters
    eyebrow="home.work.eyebrow"
    note="home.work.note"
  />
  <ProcessSteps locale={locale} />
  <PackageCards locale={locale} headline="home.packages.headline" showCustom />
  <FaqList locale={locale} items={homeFaq} />
  <FinalCta locale={locale} />
  <SiteFooter locale={locale} pageKey={pageKey} />
</div>

<style>
  .hover-card video {
    opacity: 0;
    transition-property: opacity;
    transition-duration: var(--dur-hover);
    transition-timing-function: var(--ease-fox);
  }

  .hover-card:hover video,
  .hover-card:focus-within video {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .hover-card video {
      display: none;
    }
  }
</style>

<script>
  import { prefersReducedMotion } from '../../motion/reduced';
  import { onPageReady } from '../../motion/ready';

  function bootHoverCards() {
    if (prefersReducedMotion()) return;
    document
      .querySelectorAll<HTMLElement>('[data-hover-card]')
      .forEach((card) => {
        const video = card.querySelector('video');
        if (!video || card.dataset.booted === 'true') return;
        card.dataset.booted = 'true';
        const play = () => void video.play().catch(() => undefined);
        const stop = () => video.pause();
        card.addEventListener('pointerenter', play);
        card.addEventListener('pointerleave', stop);
        card.addEventListener('focusin', play);
        card.addEventListener('focusout', stop);
      });
  }

  onPageReady(bootHoverCards);
</script>
