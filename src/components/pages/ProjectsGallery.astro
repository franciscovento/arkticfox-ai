---
import FrostField from '@/components/motion/FrostField.astro';
import GlassSheen from '@/components/motion/GlassSheen.astro';
import Marquee from '@/components/motion/Marquee.astro';
import Reveal from '@/components/motion/Reveal.astro';
import SnowCanvas from '@/components/motion/SnowCanvas.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import type { Locale, PageKey } from '@/i18n/routes';
import type { UiKey } from '@/i18n/ui/en';
import { getPath, t } from '@/i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const nav: { pageKey: PageKey; label: UiKey }[] = [
  { pageKey: 'productImages', label: 'page.productImages.heading' },
  { pageKey: 'adVideos', label: 'page.adVideos.heading' },
  { pageKey: 'ugcVideos', label: 'page.ugcVideos.heading' },
];

const media = '/media/projects';

type Piece = {
  src: string;
  poster?: string;
  kind: 'image' | 'video';
  ratio: 'story' | 'square';
  /** Span two columns so baked-in type and 1:1 frames stay readable. */
  wide?: boolean;
  label: UiKey;
  title: UiKey;
  alt: UiKey;
};

type Case = {
  id: string;
  eyebrow: UiKey;
  title: UiKey;
  body: UiKey;
  note?: UiKey;
  pieces: Piece[];
};

const cases: Case[] = [
  {
    id: 'cadillac',
    eyebrow: 'projects.cadillac.eyebrow',
    title: 'projects.cadillac.title',
    body: 'projects.cadillac.body',
    note: 'projects.ugcNote',
    pieces: [
      {
        src: `${media}/cadillac-1.mp4`,
        poster: `${media}/cadillac-1.jpg`,
        kind: 'video',
        ratio: 'square',
        wide: true,
        label: 'projects.kind.ad',
        title: 'projects.piece.lyriq',
        alt: 'projects.piece.lyriqAlt',
      },
      {
        src: `${media}/cadillac-2.mp4`,
        poster: `${media}/cadillac-2.jpg`,
        kind: 'video',
        ratio: 'story',
        label: 'projects.kind.ad',
        title: 'projects.piece.deals',
        alt: 'projects.piece.dealsAlt',
      },
      {
        src: `${media}/cadillac-ugc.mp4`,
        poster: `${media}/cadillac-ugc.jpg`,
        kind: 'video',
        ratio: 'story',
        label: 'projects.kind.ugc',
        title: 'projects.piece.driver',
        alt: 'projects.piece.driverAlt',
      },
      {
        src: `${media}/autos-9x16-2.webp`,
        kind: 'image',
        ratio: 'story',
        wide: true,
        label: 'projects.kind.ad',
        title: 'projects.piece.cadillacOffer',
        alt: 'projects.piece.cadillacOfferAlt',
      },
      {
        src: `${media}/cadillac-image-9.webp`,
        kind: 'image',
        ratio: 'story',
        label: 'projects.kind.still',
        title: 'projects.piece.fogA',
        alt: 'projects.piece.fogAAlt',
      },
      {
        src: `${media}/cadillac-image-12.webp`,
        kind: 'image',
        ratio: 'story',
        label: 'projects.kind.still',
        title: 'projects.piece.fogB',
        alt: 'projects.piece.fogBAlt',
      },
      {
        src: `${media}/cadillac-image-14.webp`,
        kind: 'image',
        ratio: 'story',
        label: 'projects.kind.still',
        title: 'projects.piece.fogC',
        alt: 'projects.piece.fogCAlt',
      },
    ],
  },
  {
    id: 'kia',
    eyebrow: 'projects.kia.eyebrow',
    title: 'projects.kia.title',
    body: 'projects.kia.body',
    pieces: [
      {
        src: `${media}/kia-image-7.webp`,
        kind: 'image',
        ratio: 'story',
        wide: true,
        label: 'projects.kind.still',
        title: 'projects.piece.kiaA',
        alt: 'projects.piece.kiaAAlt',
      },
      {
        src: `${media}/kia-image-9.webp`,
        kind: 'image',
        ratio: 'story',
        wide: true,
        label: 'projects.kind.still',
        title: 'projects.piece.kiaB',
        alt: 'projects.piece.kiaBAlt',
      },
    ],
  },
  {
    id: 'nissan',
    eyebrow: 'projects.nissan.eyebrow',
    title: 'projects.nissan.title',
    body: 'projects.nissan.body',
    pieces: [
      {
        src: `${media}/autos-9x16-1.webp`,
        kind: 'image',
        ratio: 'story',
        wide: true,
        label: 'projects.kind.ad',
        title: 'projects.piece.nissan',
        alt: 'projects.piece.nissanAlt',
      },
    ],
  },
  {
    id: 'jeep',
    eyebrow: 'projects.jeep.eyebrow',
    title: 'projects.jeep.title',
    body: 'projects.jeep.body',
    note: 'projects.ugcNote',
    pieces: [
      {
        src: `${media}/jeep-ugc.mp4`,
        poster: `${media}/jeep-ugc.jpg`,
        kind: 'video',
        ratio: 'story',
        wide: true,
        label: 'projects.kind.ugc',
        title: 'projects.piece.jeep',
        alt: 'projects.piece.jeepAlt',
      },
      {
        src: `${media}/selfie-mirror.webp`,
        kind: 'image',
        ratio: 'square',
        wide: true,
        label: 'projects.kind.ugc',
        title: 'projects.piece.selfie',
        alt: 'projects.piece.selfieAlt',
      },
    ],
  },
];
---

<BaseLayout
  locale={locale}
  pageKey="projects"
  title={t(locale, 'projects.title')}
  description={t(locale, 'projects.description')}
  bodyClass="bg-polar-night"
>
  <FrostField fixed />
  <div class="work-snow" aria-hidden="true">
    <SnowCanvas />
  </div>
  <header class="relative z-20 flex flex-wrap items-center justify-between gap-y-3 px-5 py-5 md:px-10">
    <nav
      class="order-last flex w-full items-center gap-6 sm:hidden lg:order-none lg:flex lg:w-auto"
      aria-label={t(locale, 'home.navLabel')}
    >
      {nav.map((item) => (
        <a
          class="label hover-fox hidden text-white lg:inline"
          href={getPath(locale, item.pageKey)}
        >
          {t(locale, item.label)}
        </a>
      ))}
      <a
        class="label hover-fox text-white lg:hidden"
        href={getPath(locale, 'projects')}
        aria-current="page"
      >
        {t(locale, 'nav.projects')}
      </a>
    </nav>
    <a
      class="label text-white lg:absolute lg:left-1/2 lg:-translate-x-1/2"
      href={getPath(locale, 'home')}
    >
      {t(locale, 'meta.siteName')}
    </a>
    <div class="flex items-center gap-3 md:gap-5">
      <a
        class="label hover-fox hidden text-white sm:inline"
        href={getPath(locale, 'projects')}
        aria-current="page"
      >
        {t(locale, 'nav.projects')}
      </a>
      <a
        class:list={[
          'label hover-fox',
          locale === 'en' ? 'text-white' : 'text-white/70',
        ]}
        href={getPath('en', 'projects')}
        hreflang="en"
        aria-current={locale === 'en' ? 'page' : undefined}
      >
        {t(locale, 'nav.languageEn')}
      </a>
      <a
        class:list={[
          'label hover-fox',
          locale === 'es' ? 'text-white' : 'text-white/70',
        ]}
        href={getPath('es', 'projects')}
        hreflang="es"
        aria-current={locale === 'es' ? 'page' : undefined}
      >
        {t(locale, 'nav.languageEs')}
      </a>
      <a
        class="hover-fox inline-flex items-center rounded-pill bg-brand-gradient px-4 py-2.5 font-sans text-xs font-medium text-white md:px-5 md:py-3 md:text-sm"
        href={getPath(locale, 'quote')}
      >
        {t(locale, 'nav.quote')}
      </a>
    </div>
  </header>

  <main class="relative z-10">
    <section class="px-5 pt-10 pb-6 md:px-10 md:pt-16">
      <Reveal>
        <p class="label text-ice-blue">{t(locale, 'projects.eyebrow')}</p>
        <h1 class="mt-4 max-w-3xl font-serif text-4xl leading-none text-white md:text-6xl lg:text-7xl">
          {t(locale, 'projects.headingLead')}{' '}
          <em class="italic">{t(locale, 'projects.headingEmphasis')}</em>
        </h1>
        <p class="mt-5 max-w-xl font-sans text-sm leading-relaxed text-white/85 md:text-base">
          {t(locale, 'projects.lead')}
        </p>
      </Reveal>
    </section>

    <Marquee class="py-4 text-white/80" label={t(locale, 'projects.marquee')} />

    {cases.map((item) => (
      <section
        class="px-5 py-12 md:px-10 md:py-16"
        aria-labelledby={`${item.id}-title`}
      >
        <Reveal>
          <article class="glass sheen max-w-2xl p-5 md:p-6" data-sheen>
            <p class="label text-ice-blue">{t(locale, item.eyebrow)}</p>
            <h2
              id={`${item.id}-title`}
              class="mt-3 font-serif text-3xl leading-tight text-white md:text-5xl"
            >
              {t(locale, item.title)}
            </h2>
            <p class="mt-4 font-sans text-sm leading-relaxed text-white/85 md:text-base">
              {t(locale, item.body)}
            </p>
            {item.note && (
              <p class="mt-4 font-sans text-sm text-white/85">
                {t(locale, item.note)}
              </p>
            )}
          </article>
        </Reveal>
        <div class="mt-8 grid grid-cols-2 items-start gap-4 md:grid-cols-4 md:gap-5">
          {item.pieces.map((piece) => (
            <figure
              class:list={[
                'flex min-w-0 flex-col gap-3',
                piece.wide && 'col-span-2',
              ]}
            >
              <div
                class:list={[
                  'overflow-hidden rounded-card-sm border border-glass-border bg-ink',
                  piece.ratio === 'square' ? 'aspect-square' : 'aspect-[9/16]',
                ]}
              >
                {piece.kind === 'video' ? (
                  <video
                    class="h-full w-full object-contain"
                    poster={piece.poster}
                    muted
                    playsinline
                    loop
                    preload="none"
                    controls
                    data-project-video
                    aria-label={t(locale, piece.alt)}
                    width={piece.ratio === 'square' ? 1080 : 1080}
                    height={piece.ratio === 'square' ? 1080 : 1920}
                  >
                    <source src={piece.src} type="video/mp4" />
                    {t(locale, piece.title)}
                  </video>
                ) : (
                  <img
                    class="h-full w-full object-contain"
                    src={piece.src}
                    alt={t(locale, piece.alt)}
                    width={piece.ratio === 'square' ? 1080 : 1080}
                    height={piece.ratio === 'square' ? 1080 : 1920}
                    loading="lazy"
                    decoding="async"
                  />
                )}
              </div>
              <figcaption class="flex flex-col gap-1">
                <p class="label text-ice-blue">{t(locale, piece.label)}</p>
                <p class="font-sans text-sm text-white">
                  {t(locale, piece.title)}
                </p>
              </figcaption>
            </figure>
          ))}
        </div>
      </section>
    ))}

    <section class="px-5 py-16 md:px-10 md:py-24">
      <Reveal>
        <p class="max-w-xl font-serif text-3xl leading-tight text-white md:text-5xl">
          {t(locale, 'projects.note')}
        </p>
        <a
          class="hover-fox mt-6 inline-flex items-center rounded-pill border border-white px-6 py-3 font-sans text-sm font-medium text-white"
          href={getPath(locale, 'quote')}
        >
          {t(locale, 'nav.quote')}
        </a>
      </Reveal>
    </section>
  </main>
  <GlassSheen />
</BaseLayout>

<script>
  import { prefersReducedMotion } from '../../motion/reduced';
  import { onPageReady } from '../../motion/ready';

  let videoObserver: IntersectionObserver | undefined;

  function bootProjectVideos() {
    videoObserver?.disconnect();
    const videos = [
      ...document.querySelectorAll<HTMLVideoElement>('[data-project-video]'),
    ];

    for (const video of videos) {
      video.addEventListener('pause', () => {
        if (video.dataset.driving === 'true') return;
        video.dataset.hold = 'true';
      });
    }

    if (prefersReducedMotion()) {
      for (const video of videos) {
        video.pause();
        video.preload = 'none';
        video.removeAttribute('autoplay');
      }
      return;
    }

    videoObserver = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const video = entry.target as HTMLVideoElement;
          video.dataset.driving = 'true';
          if (entry.isIntersecting && video.dataset.hold !== 'true')
            void video.play().catch(() => {});
          else video.pause();
          video.dataset.driving = 'false';
        }
      },
      { threshold: 0.45 },
    );

    for (const video of videos) videoObserver.observe(video);
  }

  document.addEventListener('astro:before-swap', () =>
    videoObserver?.disconnect(),
  );
  onPageReady(bootProjectVideos);
</script>
