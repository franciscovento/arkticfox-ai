---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { t } from '@/i18n/utils';

const locale = 'en';
const copy = {
  esHeadline: t('es', 'notFound.headline'),
  esBody: t('es', 'notFound.body'),
  esHome: t('es', 'notFound.home'),
  esAlt: t('es', 'media.foxInTunnelAlt'),
};
---

<BaseLayout
  locale={locale}
  title={`${t('en', 'notFound.kicker')} · ${t('en', 'meta.siteName')}`}
  description={t('en', 'notFound.body')}
  robots="noindex, follow"
  bodyClass="bg-polar-night"
>
  <main
    id="content"
    class="relative isolate flex min-h-svh items-end px-5 pt-16 pb-40 text-white md:px-10"
  >
    <img
      class="absolute inset-0 -z-20 h-full w-full object-cover"
      src="/media/brand/fox-in-snow-tunnel.webp"
      alt={t('en', 'media.foxInTunnelAlt')}
    />
    <div class="absolute inset-0 -z-10 bg-scrim"></div>
    <div class="relative max-w-xl" data-not-found>
      <img
        src="/media/brand/logo-mark-white.png"
        alt=""
        width="788"
        height="396"
        class="mb-6 h-12 w-auto"
      />
      <p class="label text-ice-blue" data-kicker>
        {t('en', 'notFound.kicker')}
      </p>
      <h1
        class="mt-3 font-serif text-5xl leading-tight md:text-7xl"
        data-headline
      >
        {t('en', 'notFound.headline')}
      </h1>
      <p class="mt-4 font-sans text-base text-white/85" data-body>
        {t('en', 'notFound.body')}
      </p>
      <a
        class="hover-fox mt-8 inline-flex items-center rounded-pill bg-brand-gradient px-6 py-3 font-sans text-sm font-medium text-white"
        href="/"
        data-home
      >
        {t('en', 'notFound.home')}
      </a>
    </div>
  </main>
</BaseLayout>

<script
  type="application/json"
  id="not-found-copy"
  set:html={JSON.stringify(copy)}
/>
<script>
  const node = document.querySelector('#not-found-copy');
  const spanish =
    window.location.pathname === '/es' ||
    window.location.pathname.startsWith('/es/');
  if (spanish && node?.textContent) {
    const copy = JSON.parse(node.textContent) as {
      esHeadline: string;
      esBody: string;
      esHome: string;
      esAlt: string;
    };
    document.documentElement.lang = 'es';
    const headline = document.querySelector('[data-headline]');
    const body = document.querySelector('[data-body]');
    const home = document.querySelector<HTMLAnchorElement>('[data-home]');
    const image = document.querySelector('main img');
    if (headline) headline.textContent = copy.esHeadline;
    if (body) body.textContent = copy.esBody;
    if (home) {
      home.textContent = copy.esHome;
      home.setAttribute('href', '/es/');
    }
    if (image) image.setAttribute('alt', copy.esAlt);
  }
</script>
