---
import SiteFooter from '@/components/chrome/SiteFooter.astro';
import SiteHeader from '@/components/chrome/SiteHeader.astro';
import FaqList from '@/components/sections/FaqList.astro';
import FinalCta from '@/components/sections/FinalCta.astro';
import LazyVideo from '@/components/sections/LazyVideo.astro';
import PackageCards from '@/components/sections/PackageCards.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { alaCarte, packageCopy, packageOrder, pricingFaq } from '@/lib/catalog';
import type { Locale } from '@/i18n/routes';
import type { UiKey } from '@/i18n/ui/en';
import { getPath, t } from '@/i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const rows: { label: UiKey; cells: UiKey[] }[] = [
  {
    label: 'pricing.compare.type',
    cells: ['pricing.pilot.type', 'pricing.growth.type', 'pricing.scale.type'],
  },
  {
    label: 'pricing.compare.from',
    cells: [
      'pricing.pilot.price',
      'pricing.growth.price',
      'pricing.scale.price',
    ],
  },
  {
    label: 'pricing.compare.ugc',
    cells: [
      'pricing.compare.ugc1',
      'pricing.compare.ugc2',
      'pricing.compare.ugc3',
    ],
  },
  {
    label: 'pricing.compare.ads',
    cells: [
      'pricing.compare.none',
      'pricing.compare.ads2',
      'pricing.compare.ads3',
    ],
  },
  {
    label: 'pricing.compare.stills',
    cells: [
      'pricing.compare.stills1',
      'pricing.compare.stills2',
      'pricing.compare.stills3',
    ],
  },
  {
    label: 'pricing.compare.hooks',
    cells: [
      'pricing.compare.hooksPilot',
      'pricing.compare.yes',
      'pricing.compare.yes',
    ],
  },
  {
    label: 'pricing.compare.script',
    cells: [
      'pricing.compare.scriptPilot',
      'pricing.compare.inQuote',
      'pricing.compare.inQuote',
    ],
  },
  {
    label: 'pricing.compare.revisions',
    cells: [
      'pricing.compare.revisionsPilot',
      'pricing.compare.inQuote',
      'pricing.compare.inQuote',
    ],
  },
  {
    label: 'pricing.compare.review',
    cells: [
      'pricing.compare.none',
      'pricing.compare.none',
      'pricing.compare.yes',
    ],
  },
];
---

<BaseLayout
  locale={locale}
  pageKey="pricing"
  title={t(locale, 'meta.pricingTitle')}
  description={t(locale, 'meta.pricingDescription')}
  bodyClass="bg-snow-white"
>
  <SiteHeader locale={locale} pageKey="pricing" />
  <main id="content">
    <section class="relative isolate flex min-h-[70svh] items-end overflow-hidden bg-polar-night px-5 pt-32 pb-16 text-white md:px-10">
      <div class="absolute inset-0 -z-20 scale-110 blur-md" aria-hidden="true">
        <LazyVideo
          src="/media/clips/snow-dawn-loop.mp4"
          poster="/media/clips/snow-dawn-loop-poster.jpg"
          label={t(locale, 'media.clipDawnAlt')}
        />
      </div>
      <img
        class="absolute inset-0 -z-10 h-full w-full object-cover opacity-80"
        src="/media/brand/snow-tunnel-empty.webp"
        alt=""
      />
      <div class="absolute inset-0 -z-10 bg-scrim"></div>
      <div class="relative max-w-3xl">
        <p class="label text-ice-blue">{t(locale, 'pricing.hero.eyebrow')}</p>
        <h1 class="mt-4 font-serif text-5xl leading-tight md:text-7xl">
          {t(locale, 'pricing.hero.headlineLead')}{' '}
          <em class="italic">{t(locale, 'pricing.hero.headlineEmphasis')}</em>.
        </h1>
        <p class="mt-5 max-w-xl font-sans text-sm leading-relaxed text-white/85 md:text-base">
          {t(locale, 'pricing.hero.subhead')}
        </p>
      </div>
    </section>

    <PackageCards locale={locale} />

    <section id="a-la-carte" class="bg-snow-white px-5 pb-20 md:px-10 md:pb-28">
      <div class="mx-auto max-w-6xl">
        <h2 class="font-serif text-4xl text-ink md:text-6xl">
          {t(locale, 'pricing.alaCarte.headline')}
        </h2>
        <p class="mt-3 font-serif text-2xl text-ink">
          {t(locale, 'pricing.alaCarte.subhead')}
        </p>
        <ul class="mt-8 grid gap-4 md:grid-cols-3">
          {alaCarte.map((card) => (
            <li class="flex flex-col gap-4 rounded-card border border-snow-gray bg-white p-6">
              <h3 class="font-serif text-3xl text-ink">
                {t(locale, card.title)}
              </h3>
              <p class="font-sans text-sm text-ink">
                {t(locale, 'pricing.alaCarte.price')}
              </p>
              <a
                class="hover-fox mt-auto inline-flex w-fit items-center rounded-pill border border-ink px-5 py-2.5 font-sans text-sm font-medium text-ink"
                href={getPath(locale, 'quote')}
              >
                {t(locale, 'shared.cta.quote')}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="bg-snow-white px-5 pb-20 md:px-10 md:pb-28">
      <div class="mx-auto max-w-6xl">
        <h2 class="font-serif text-4xl text-ink md:text-5xl">
          {t(locale, 'pricing.compare.headline')}
        </h2>
        <div class="mt-8 overflow-x-auto">
          <table class="w-full min-w-[40rem] border-collapse text-left font-sans text-sm text-ink">
            <thead>
              <tr>
                <th class="border-b border-snow-gray py-3 pr-4"></th>
                {packageOrder.map((id) => (
                  <th class="border-b border-snow-gray py-3 pr-4 font-serif text-2xl font-normal">
                    {t(locale, packageCopy[id].name)}
                  </th>
                ))}
              </tr>
            </thead>
            <tbody>
              {rows.map((row) => (
                <tr>
                  <th
                    class="border-b border-snow-gray py-3 pr-4 font-medium"
                    scope="row"
                  >
                    {t(locale, row.label)}
                  </th>
                  {row.cells.map((cell) => (
                    <td class="border-b border-snow-gray py-3 pr-4">
                      {t(locale, cell)}
                    </td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="mt-4 max-w-2xl font-sans text-sm text-ink">
          {t(locale, 'pricing.compare.note')}
        </p>
        <p class="mt-2 max-w-2xl font-sans text-sm text-ink">
          {t(locale, 'shared.pricing.vatShort')}
        </p>
      </div>
    </section>

    <FaqList locale={locale} items={pricingFaq} />
    <FinalCta locale={locale} />
  </main>
  <SiteFooter locale={locale} pageKey="pricing" />
</BaseLayout>
