---
import FoxHeroScene from '@/components/islands/FoxHeroScene';
import BaseLayout from '@/layouts/BaseLayout.astro';
import type { Locale } from '@/i18n/routes';
import { getPath, t } from '@/i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<BaseLayout
  locale={locale}
  pageKey="hero3d"
  title={t(locale, 'hero3d.title')}
  description={t(locale, 'hero3d.description')}
  noindex
  bodyClass="bg-sky-high"
>
  <section
    class="relative min-h-svh"
    data-fox-stage
    data-fox-state="loading"
    data-fox-progress="0"
  >
    <div class="relative min-h-svh" data-fox-sticky>
      <div
        class="fixed inset-0 z-50 flex flex-col items-center justify-center gap-8 bg-polar-night"
        data-loader
        data-fox-loader
        role="status"
      >
        <p class="label text-white">{t(locale, 'meta.siteName')}</p>
        <div
          class="h-px w-36 overflow-hidden bg-glass-border"
          aria-hidden="true"
        >
          <div
            class="h-full w-full bg-white"
            data-loader-bar
            data-fox-loader-bar
          ></div>
        </div>
        <p class="sr-only">{t(locale, 'home.loading')}</p>
      </div>

      <FoxHeroScene client:only="react" />

      <div
        class="pointer-events-none absolute inset-0 z-10 bg-hero-scrim"
        aria-hidden="true"
      ></div>
      <div
        class="pointer-events-none absolute inset-0 z-10 bg-hero-scrim-top md:hidden"
        aria-hidden="true"
      ></div>

      <header class="fixed inset-x-0 top-0 z-30 flex items-center justify-between px-5 py-5 md:px-10">
        <a class="label hover-fox text-white" href={getPath(locale, 'home')}>
          {t(locale, 'meta.siteName')}
        </a>
        <div class="flex items-center gap-3 md:gap-5">
          <a
            class:list={[
              'label hover-fox',
              locale === 'en' ? 'text-white' : 'text-white/70',
            ]}
            href={getPath('en', 'hero3d')}
            hreflang="en"
            aria-current={locale === 'en' ? 'page' : undefined}
          >
            {t(locale, 'nav.languageEn')}
          </a>
          <a
            class:list={[
              'label hover-fox',
              locale === 'es' ? 'text-white' : 'text-white/70',
            ]}
            href={getPath('es', 'hero3d')}
            hreflang="es"
            aria-current={locale === 'es' ? 'page' : undefined}
          >
            {t(locale, 'nav.languageEs')}
          </a>
          <a
            class="hover-fox inline-flex items-center rounded-pill border border-white px-4 py-2.5 font-sans text-xs font-medium whitespace-nowrap text-white md:px-5 md:py-3 md:text-sm"
            href={getPath(locale, 'quote')}
          >
            {t(locale, 'nav.quote')}
          </a>
        </div>
      </header>

      <div class="pointer-events-none absolute inset-0 z-20 flex flex-col justify-end px-5 pt-28 pb-20 md:justify-center md:px-16">
        <p class="label text-ice-blue">{t(locale, 'home.eyebrow')}</p>
        <h1 class="mt-4 max-w-3xl font-serif text-4xl leading-tight text-white md:text-5xl lg:text-6xl">
          <span class="block">
            {t(locale, 'home.line1Lead')}{' '}
            <em class="italic">{t(locale, 'home.line1Emphasis')}</em>,
          </span>
          <span class="block">
            {t(locale, 'home.line2Lead')}{' '}
            <em class="italic">{t(locale, 'home.line2Emphasis')}</em>.
          </span>
        </h1>
        <p class="mt-5 max-w-md font-sans text-sm leading-relaxed text-white/85 md:text-base">
          {t(locale, 'home.subhead')}
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a
            class="hover-fox pointer-events-auto inline-flex items-center rounded-pill bg-brand-gradient px-6 py-3 font-sans text-sm font-medium text-white"
            href={getPath(locale, 'quote')}
          >
            {t(locale, 'nav.quote')}
          </a>
          <a
            class="hover-fox pointer-events-auto inline-flex items-center rounded-pill border border-white px-6 py-3 font-sans text-sm font-medium text-white"
            href={getPath(locale, 'pricing')}
          >
            {t(locale, 'nav.pricing')}
          </a>
        </div>
      </div>

      <p class="label pointer-events-none absolute inset-x-0 bottom-6 z-20 text-center text-white">
        {t(locale, 'hero3d.hint')}
      </p>
      <p class="sr-only">{t(locale, 'hero3d.scene')}</p>
    </div>
  </section>
</BaseLayout>
