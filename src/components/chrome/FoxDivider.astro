---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={['flex items-center gap-4', className]} aria-hidden="true">
  <span class="h-px flex-1 bg-snow-gray"></span>
  <img
    src="/media/brand/logo-mark-white.png"
    alt=""
    width="788"
    height="396"
    class="h-8 w-auto rounded-pill bg-polar-night px-3 py-1"
  />
  <span class="h-px flex-1 bg-snow-gray"></span>
</div>
