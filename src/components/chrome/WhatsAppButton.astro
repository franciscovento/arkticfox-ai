---
import { whatsappHref } from '@/lib/contact';
import type { Locale } from '@/i18n/routes';
import { t } from '@/i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const href = whatsappHref(locale);
---

{href && (
  <a
    class="hover-fox fixed right-4 bottom-4 z-40 inline-flex items-center rounded-pill border border-white bg-polar-night px-4 py-3 font-sans text-sm font-medium text-white md:right-6 md:bottom-6"
    href={href}
    rel="noopener noreferrer"
  >
    {t(locale, 'shared.whatsapp.label')}
  </a>
)}
