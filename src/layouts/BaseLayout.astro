---
import '@/styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Hreflang from '@/components/seo/Hreflang.astro';
import Seo from '@/components/seo/Seo.astro';
import type { Locale, PageKey } from '@/i18n/routes';
import { t } from '@/i18n/utils';

interface Props {
  title: string;
  description: string;
  locale?: Locale;
  pageKey?: PageKey;
  noindex?: boolean;
  bodyClass?: string;
}

const { title, description, locale = 'en', pageKey, noindex = false, bodyClass = '' } = Astro.props;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <Seo
      title={title}
      description={description}
      siteName={t(locale, 'meta.siteName')}
      noindex={noindex}
    />
    {pageKey && <Hreflang pageKey={pageKey} />}
    <ClientRouter />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body class={bodyClass}>
    <slot />
  </body>
</html>
